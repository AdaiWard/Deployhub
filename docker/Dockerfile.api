FROM golang:1.24-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/deployhub-api ./cmd/api

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata && addgroup -S deployhub && adduser -S -G deployhub deployhub
COPY --from=build /out/deployhub-api /usr/local/bin/deployhub-api
USER deployhub
EXPOSE 8080
ENTRYPOINT ["deployhub-api"]
